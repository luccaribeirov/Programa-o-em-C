#include <stdio.h>

int main(void) {
    int valor = 20;
    int *ponteiro;

    ponteiro = &valor; // O ponteiro recebe o endereco de 'valor'

    printf("Valor da variavel: %d\n", valor);
    printf("Endereco da variavel: %p\n", (void *)&valor);
    printf("Endereco armazenado no ponteiro: %p\n", (void *)ponteiro);
    printf("Valor acessado pelo ponteiro: %d\n", *ponteiro);

    return 0;
}
